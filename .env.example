# Configuration locale TutosVideo
# Copiez ce fichier vers `.env`, puis renseignez les valeurs.
# Ne jamais committer `.env`.

# --- IA (Mistral) ---
MISTRAL_API_KEY=
MISTRAL_VOICE_ID=
MISTRAL_CHAT_MODEL=
MISTRAL_TTS_MODEL=
MISTRAL_VISION_MODEL=

# --- Compte d'essai ---
TUTO_EMAIL=
TUTO_PASSWORD=
TUTO_COMPANY=
TUTO_PHONE=
TUTO_SUBDOMAIN=

# --- Dolibarr ---
TUTO_DOLIBARR_LOGIN=
TUTO_DOLIBARR_PASSWORD=

# --- E-mail (IMAP) ---
IMAP_HOST=
IMAP_PORT=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=
VERIFY_CODE_FILE=
