#!/usr/bin/env bash
# Lance tutosvideo via le venv local (chemins relatifs au dépôt).
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

VENV_DIR="${VENV_DIR:-.venv}"

if [[ ! -x "$VENV_DIR/bin/tutosvideo" ]]; then
  echo "venv absent ou incomplet. Lancez d'abord : ./scripts/setup.sh" >&2
  exit 1
fi

# shellcheck disable=SC1091
source "$VENV_DIR/bin/activate"
exec tutosvideo "$@"
